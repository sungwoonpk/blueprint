---
import Base from '../layouts/Base.astro';
import { phases, groupedTopics } from '../data/roadmap';
---

<Base title="Roadmap" description="Every phase and topic in the system design roadmap.">
  <div class="container layout">
    <aside class="toc" aria-label="Phases">
      <p class="toc-title">Phases</p>
      <ol>
        {
          phases.map((phase, i) => (
            <li>
              <a href={`#${phase.slug}`}>
                <span class="num">{i + 1}</span>
                {phase.title}
              </a>
            </li>
          ))
        }
      </ol>
    </aside>

    <div class="content">
      <header class="intro">
        <p class="eyebrow">Roadmap</p>
        <h1>Everything, in order</h1>
        <p class="muted">
          {phases.length} phases. Topics are numbered in reading order. Articles are added over time, so unwritten topics
          are marked as planned.
        </p>
      </header>

      {
        phases.map((phase, i) => (
          <section id={phase.slug} class="phase">
            <div class="phase-head">
              <span class="phase-num num">{i + 1}</span>
              <div>
                <h2>{phase.title}</h2>
                <p class="muted">{phase.summary}</p>
              </div>
            </div>
            {groupedTopics(phase).map((group) => (
              <div class="group">
                {group.name && <h3>{group.name}</h3>}
                <ul>
                  {group.topics.map((t) => (
                    <li>
                      <a href={`/topics/${t.slug}`} class="row">
                        <span class="n num">{t.number}</span>
                        <span class="t">{t.title}</span>
                        <span class="pill">Planned</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    gap: 32px;
    padding-top: 56px;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 220px 1fr;
      gap: 56px;
    }
  }
  .toc {
    display: none;
  }
  @media (min-width: 900px) {
    .toc {
      display: block;
      position: sticky;
      top: 92px;
      align-self: start;
      max-height: calc(100vh - 120px);
      overflow: auto;
    }
  }
  .toc-title {
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc a {
    display: flex;
    gap: 10px;
    padding: 6px 10px;
    margin-left: -10px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--text);
    background: var(--surface);
  }
  .toc .num {
    color: var(--accent);
    min-width: 1ch;
  }

  .intro h1 {
    margin-top: 8px;
    font-size: clamp(30px, 4.5vw, 40px);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .intro p:last-child {
    margin-top: 12px;
    max-width: 60ch;
  }

  .phase {
    margin-top: 64px;
  }
  .phase-head {
    display: flex;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }
  .phase-num {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
  }
  .phase-head h2 {
    font-size: 22px;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .phase-head p {
    margin-top: 4px;
    font-size: 15px;
  }

  .group {
    margin-top: 28px;
  }
  .group h3 {
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 10px 12px;
    margin: 0 -12px;
    border-radius: 10px;
  }
  .row:hover {
    background: var(--surface);
  }
  .n {
    flex: none;
    min-width: 3.2ch;
    font-size: 13.5px;
    color: var(--muted);
  }
  .t {
    flex: 1;
  }
  .row:hover .t {
    color: var(--accent);
  }
  .pill {
    align-self: center;
  }
</style>
