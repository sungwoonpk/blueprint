---
import Base from '../layouts/Base.astro';
import { phases, groupedTopics } from '../data/roadmap';
---

<Base>
  <div class="layout">
    <nav class="phases" aria-label="Phases">
      <ol>
        {
          phases.map((phase, i) => (
            <li>
              <a href={`#${phase.slug}`}>
                <span class="num">{i + 1}</span>
                {phase.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="content">
      <h1>Roadmap</h1>

      {
        phases.map((phase, i) => (
          <section id={phase.slug}>
            <p class="eyebrow">Phase {i + 1}</p>
            <h2>{phase.title}</h2>
            <div class="groups">
              {groupedTopics(phase).map((group) =>
                group.name ? (
                  <details class="group">
                    <summary>
                      <span class="g">{group.name}</span>
                      <span class="count num">{group.topics.length}</span>
                      <svg class="chev" viewBox="0 0 8 14" width="8" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M1 1l6 6-6 6" />
                      </svg>
                    </summary>
                    <ul class="topics">
                      {group.topics.map((t) => (
                        <li>
                          <a href={`/topics/${t.slug}`} class="row">
                            <span class="n num">{t.number}</span>
                            <span class="t">{t.title}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                ) : (
                  <ul class="topics ungrouped">
                    {group.topics.map((t) => (
                      <li>
                        <a href={`/topics/${t.slug}`} class="row">
                          <span class="n num">{t.number}</span>
                          <span class="t">{t.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ),
              )}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<script>
  // Highlight the phase currently in view in the side list.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.phases a').forEach((a) => links.set(a.hash.slice(1), a));

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.classList.remove('active'));
        links.get(entry.target.id)?.classList.add('active');
      }
    },
    { rootMargin: '-20% 0px -70% 0px' },
  );
  document.querySelectorAll('section[id]').forEach((s) => observer.observe(s));
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 64px;
    }
  }

  .phases {
    display: none;
  }
  @media (min-width: 900px) {
    .phases {
      display: block;
      position: sticky;
      top: 96px;
      align-self: start;
    }
  }
  .phases ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .phases a {
    display: flex;
    gap: 10px;
    padding: 5px 0;
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }
  .phases a .num {
    flex: none;
    width: 1.2ch;
  }
  .phases a:hover,
  .phases a.active {
    color: var(--text);
  }
  .phases a.active {
    font-weight: 600;
  }

  .content {
    max-width: 700px;
  }
  h1 {
    font-size: clamp(40px, 7vw, 56px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  section {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  h1 + section {
    margin-top: 48px;
    padding-top: 0;
    border-top: 0;
  }
  .eyebrow {
    font-size: 14px;
    color: var(--muted);
  }
  h2 {
    margin-top: 2px;
    font-size: 32px;
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  /* One rounded list per phase; each group is a row that expands. */
  .groups {
    margin-top: 24px;
    overflow: hidden;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
    transition: background-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .groups > * + * {
    border-top: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 18px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color 0.2s var(--ease);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--surface-hover);
  }
  .g {
    flex: 1;
    font-weight: 550;
  }
  .count {
    font-size: 14px;
    color: var(--muted);
  }
  .chev {
    flex: none;
    color: var(--muted);
    transition: transform 0.25s var(--ease);
  }
  .group[open] .chev {
    transform: rotate(90deg);
  }

  /* Smooth open and close where the browser supports animating to auto height. */
  .group {
    interpolate-size: allow-keywords;
  }
  .group::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.3s var(--ease),
      content-visibility 0.3s var(--ease) allow-discrete;
  }
  .group[open]::details-content {
    block-size: auto;
  }

  .topics {
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
  }
  .topics.ungrouped {
    padding: 8px 0;
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 9px 18px 9px 18px;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .row:hover {
    background: var(--surface-hover);
  }
  .row:hover .t {
    color: var(--accent);
  }
  .n {
    flex: none;
    min-width: 3.6ch;
    font-size: 14px;
    color: var(--muted);
  }
  .t {
    flex: 1;
    line-height: 1.4;
    transition: color 0.2s var(--ease);
  }
</style>
