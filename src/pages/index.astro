---
import Base from '../layouts/Base.astro';
import { phases, groupedTopics } from '../data/roadmap';
---

<Base>
  <div class="layout">
    <nav class="phases" aria-label="Phases">
      <ol>
        {
          phases.map((phase, i) => (
            <li>
              <a href={`#${phase.slug}`}>
                <span class="num">{i + 1}</span>
                {phase.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="content">
      <h1>Roadmap</h1>

      {
        phases.map((phase, i) => (
          <section id={phase.slug}>
            <p class="eyebrow">Phase {i + 1}</p>
            <h2>{phase.title}</h2>
            {groupedTopics(phase).map((group) => (
              <div class="group">
                {group.name && <h3>{group.name}</h3>}
                <ul class="list">
                  {group.topics.map((t) => (
                    <li>
                      <a href={`/topics/${t.slug}`} class="row">
                        <span class="n num">{t.number}</span>
                        <span class="t">{t.title}</span>
                        <svg class="chev" viewBox="0 0 8 14" width="8" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M1 1l6 6-6 6" />
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))
      }
    </div>
  </div>
</Base>

<script>
  // Highlight the phase currently in view in the side list.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.phases a').forEach((a) => links.set(a.hash.slice(1), a));

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.classList.remove('active'));
        links.get(entry.target.id)?.classList.add('active');
      }
    },
    { rootMargin: '-20% 0px -70% 0px' },
  );
  document.querySelectorAll('section[id]').forEach((s) => observer.observe(s));
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 64px;
    }
  }

  .phases {
    display: none;
  }
  @media (min-width: 900px) {
    .phases {
      display: block;
      position: sticky;
      top: 96px;
      align-self: start;
    }
  }
  .phases ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .phases a {
    display: flex;
    gap: 10px;
    padding: 5px 0;
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted);
    transition: color 0.2s var(--ease);
  }
  .phases a .num {
    flex: none;
    width: 1.2ch;
  }
  .phases a:hover,
  .phases a.active {
    color: var(--text);
  }
  .phases a.active {
    font-weight: 600;
  }

  .content {
    max-width: 700px;
  }
  h1 {
    font-size: clamp(40px, 7vw, 56px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  section {
    margin-top: 72px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  h1 + section {
    margin-top: 48px;
    padding-top: 0;
    border-top: 0;
  }
  .eyebrow {
    font-size: 14px;
    color: var(--muted);
  }
  h2 {
    margin-top: 2px;
    font-size: 32px;
    line-height: 1.15;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .group {
    margin-top: 32px;
  }
  .group h3 {
    margin: 0 0 8px 18px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
    transition: background-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .list li {
    position: relative;
  }
  .list li + li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 18px;
    right: 0;
    height: 1px;
    background: var(--border);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    transition: background-color 0.2s var(--ease);
  }
  .row:hover {
    background: var(--surface-hover);
  }
  .n {
    flex: none;
    min-width: 3.6ch;
    font-size: 14px;
    color: var(--muted);
  }
  .t {
    flex: 1;
    line-height: 1.35;
  }
  .chev {
    flex: none;
    color: var(--muted);
    opacity: 0.5;
    transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .row:hover .chev {
    opacity: 1;
    transform: translateX(2px);
  }
</style>
