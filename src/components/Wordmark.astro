---
import { SITE } from '../config';
---

<span class="wordmark">
  <b>{SITE.name}</b>
  <span class="subject">{SITE.subject}</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    letter-spacing: -0.025em;
    color: var(--text);
  }
  b {
    font-weight: 650;
  }
  .subject {
    padding-left: 10px;
    border-left: 1px solid var(--border);
    font-size: 15px;
    color: var(--muted);
    letter-spacing: -0.01em;
  }
</style>
