---
import { SITE } from '../config';

const [first, second] = SITE.nameParts;
---

<span class="wordmark"><b>{first}</b><span>{second}</span></span>

<style>
  .wordmark {
    font-size: 18px;
    letter-spacing: -0.025em;
    color: var(--text);
  }
  b {
    font-weight: 650;
  }
  span {
    font-weight: 300;
  }
</style>
