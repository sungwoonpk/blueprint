---
import { SITE } from '../config';

interface Props {
  small?: boolean;
}
const { small = false } = Astro.props;
const [first, second] = SITE.nameParts;
---

<span class:list={['wordmark', { small }]}><b>{first}</b><span>{second}</span></span>

<style>
  .wordmark {
    font-size: 19px;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .wordmark.small {
    font-size: 15px;
  }
  b {
    font-weight: 750;
  }
  span {
    font-weight: 300;
    color: var(--accent);
  }
</style>
