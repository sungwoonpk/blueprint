---
import { SITE } from '../config';
---

<span class="wordmark"><img src="/logo.png" width="19" height="19" alt="" /><span class="name">{SITE.name}</span></span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--text);
  }
  img {
    display: block;
    flex: none;
    /* Optical centering: the eye reads the name from the top of its tall
       letters to the baseline (the one descender in "p" does not count), so
       the logo is centered on that band rather than on the line box. */
    transform: translateY(-1.25px);
  }
  .name {
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1;
  }
</style>
