---
import { SITE } from '../config';
---

<span class="wordmark"><img src="/logo.png" width="20" height="20" alt="" /><span class="name">{SITE.name}</span></span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--text);
  }
  img {
    display: block;
    flex: none;
    /* Optical centering: lowercase text sits a little low in its line box. */
    transform: translateY(1px);
  }
  .name {
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1;
  }
</style>
