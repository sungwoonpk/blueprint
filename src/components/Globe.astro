---
// A small ocean planet in the logo's colors, turning slowly in the middle of
// the home page, drawn with WebGL2 in two steps.
//
// 1. Bake, once: two slow current patterns and the cloud cover are generated
//    from 3D gradient noise into one cube map, one face per frame, so loading
//    never stalls. Cube maps have no seam and no pinched poles.
// 2. Draw, every frame: find the point of the planet under each pixel, let the
//    currents drift past each other so deep blue, sky, lilac and pink flow,
//    drift the clouds, and add an atmosphere that fades from blue to white
//    with a trace of the logo's pink.
//
// Drag to turn it in any direction, all the way round; it glides, then goes
// back to its slow turn. Without WebGL2 the logo is shown instead; with reduced
// motion it holds still (it can still be turned by hand).
//
// Anything placed inside (the home page's moons) shares the planet's layer:
// below z-index 1 it passes behind the planet, above it in front.
---

<div class="globe">
  <canvas aria-hidden="true"></canvas>
  <img class="fallback" src="/logo.png" alt="" width="128" height="128" />
  <slot />
</div>

<script>
  const SECONDS_PER_TURN = 70;
  const TILT = 0.32; // radians the axis leans toward the viewer at rest
  const FACE_SIZE = 512; // cube face size for currents and clouds

  const root = document.querySelector<HTMLDivElement>('.globe')!;
  const canvas = root.querySelector('canvas')!;
  const gl = canvas.getContext('webgl2', { premultipliedAlpha: true, antialias: false, alpha: true });

  // Shared GLSL: a good integer hash and smooth 3D gradient noise.
  const NOISE = `
    uvec3 pcg3d(uvec3 v) {
      v = v * 1664525u + 1013904223u;
      v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
      v ^= v >> 16u;
      v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
      return v;
    }
    vec3 gradientAt(ivec3 p) {
      uvec3 h = pcg3d(uvec3(p + 4096));
      return normalize(vec3(h & 0xFFFFu) / 32767.5 - 1.0 + 1e-4);
    }
    float gnoise(vec3 x) {
      ivec3 i = ivec3(floor(x));
      vec3 f = fract(x);
      vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
      float n000 = dot(gradientAt(i), f);
      float n100 = dot(gradientAt(i + ivec3(1, 0, 0)), f - vec3(1, 0, 0));
      float n010 = dot(gradientAt(i + ivec3(0, 1, 0)), f - vec3(0, 1, 0));
      float n110 = dot(gradientAt(i + ivec3(1, 1, 0)), f - vec3(1, 1, 0));
      float n001 = dot(gradientAt(i + ivec3(0, 0, 1)), f - vec3(0, 0, 1));
      float n101 = dot(gradientAt(i + ivec3(1, 0, 1)), f - vec3(1, 0, 1));
      float n011 = dot(gradientAt(i + ivec3(0, 1, 1)), f - vec3(0, 1, 1));
      float n111 = dot(gradientAt(i + ivec3(1, 1, 1)), f - vec3(1, 1, 1));
      return mix(mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y),
                 mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y), u.z);
    }`;

  const QUAD = `#version 300 es
    in vec2 position;
    out vec2 p;
    void main() { p = position; gl_Position = vec4(position, 0.0, 1.0); }`;

  const BAKE = `#version 300 es
    precision highp float;
    precision highp int;
    uniform int face;
    uniform float size;
    out vec4 outColor;
    ${NOISE}
    float fbm(vec3 x, int octaves) {
      float v = 0.0, a = 0.5;
      for (int i = 0; i < 8; i++) { if (i >= octaves) break; v += a * gnoise(x); x = x * 2.02 + vec3(19.1, 7.3, 3.7); a *= 0.5; }
      return v;
    }
    vec3 direction() {
      vec2 st = gl_FragCoord.xy / size * 2.0 - 1.0;
      float sc = st.x, tc = st.y;
      if (face == 0) return normalize(vec3(1.0, -tc, -sc));
      if (face == 1) return normalize(vec3(-1.0, -tc, sc));
      if (face == 2) return normalize(vec3(sc, 1.0, tc));
      if (face == 3) return normalize(vec3(sc, -1.0, -tc));
      if (face == 4) return normalize(vec3(sc, -tc, 1.0));
      return normalize(vec3(-sc, -tc, -1.0));
    }
    void main() {
      vec3 d = direction();
      // Two current patterns, warped so they swirl rather than blob.
      vec3 w = vec3(fbm(d * 1.2 + vec3(1.3), 3), fbm(d * 1.2 + vec3(7.7), 3), fbm(d * 1.2 + vec3(4.1), 3));
      float currentA = fbm(d * 1.6 + w * 0.9, 6) * 0.5 + 0.5;
      float currentB = fbm(d * 2.4 - w * 0.7 + vec3(5.0), 6) * 0.5 + 0.5;
      // Fine streaks that follow the currents, for a crisp surface.
      float streak = 1.0 - abs(fbm(d * 6.5 + w * 1.6, 5));
      streak = pow(streak, 4.0);
      float cloud = smoothstep(0.24, 0.56, fbm(d * 2.3 + vec3(fbm(d * 1.4, 3), fbm(d * 1.4 + 3.3, 3), 0.0) * 0.8, 6));
      outColor = vec4(currentA, currentB, streak, cloud);
    }`;

  const DRAW = `#version 300 es
    precision highp float;
    precision highp int;
    in vec2 p;
    out vec4 outColor;
    uniform samplerCube detail;
    uniform mat3 orient;   // view direction to planet direction
    uniform float time;
    uniform float pixel;
    const float RADIUS = 0.84;   // sphere radius in canvas units; the rest is atmosphere
    ${NOISE}
    vec3 rotY(vec3 v, float a) { float c = cos(a), s = sin(a); return vec3(v.x * c + v.z * s, v.y, -v.x * s + v.z * c); }
    vec3 lin(vec3 c) { return pow(c, vec3(2.2)); }
    // One continuous gradient from deep blue through periwinkle and lavender to
    // pink and rose: every color meets only its neighbors, so nothing jumps.
    vec3 ramp(float t) {
      vec3 c0 = lin(vec3(0.13, 0.26, 0.64));
      vec3 c1 = lin(vec3(0.27, 0.44, 0.86));
      vec3 c2 = lin(vec3(0.48, 0.58, 0.94));
      vec3 c3 = lin(vec3(0.69, 0.64, 0.96));
      vec3 c4 = lin(vec3(0.94, 0.60, 0.84));
      vec3 c5 = lin(vec3(0.99, 0.76, 0.82));
      vec3 c = mix(c0, c1, clamp(t / 0.24, 0.0, 1.0));
      c = mix(c, c2, clamp((t - 0.24) / 0.22, 0.0, 1.0));
      c = mix(c, c3, clamp((t - 0.46) / 0.16, 0.0, 1.0));
      c = mix(c, c4, clamp((t - 0.62) / 0.16, 0.0, 1.0));
      return mix(c, c5, clamp((t - 0.78) / 0.22, 0.0, 1.0));
    }

    void main() {
      vec2 c = p / RADIUS;
      float r = length(c);
      float px = pixel / RADIUS;
      vec3 sun = normalize(vec3(-0.55, 0.45, 0.70));

      // Atmosphere beyond the edge: blue near the planet, fading through white,
      // with a breath of the logo's pink; gone before the canvas edge.
      if (r > 1.0) {
        float lit = 0.55 + 0.45 * dot(normalize(c), normalize(sun.xy));
        float fall = exp(-(r - 1.0) * 15.0);
        vec3 tint = mix(vec3(0.97, 0.86, 0.93), vec3(0.58, 0.74, 1.0), fall);
        float a = fall * 0.30 * lit * smoothstep(1.18, 1.06, r);
        outColor = vec4(tint * a, a);
        return;
      }

      float coverage = clamp((1.0 - r) / px, 0.0, 1.0);
      vec3 n = vec3(c, sqrt(max(0.0, 1.0 - r * r)));
      vec3 s = orient * n;
      vec3 view = vec3(0.0, 0.0, 1.0);
      vec3 halfway = normalize(sun + view);

      // Currents: two patterns drift past each other, and their mix is colored
      // with the logo's gradient, so deep blue, sky, lilac and pink slowly flow.
      vec3 sA = rotY(s, time * 0.012);
      vec4 a = texture(detail, sA);
      float flowB = texture(detail, rotY(s, -time * 0.009)).g;
      // A wide, soft window, so colors melt into each other instead of meeting at an edge.
      float t = smoothstep(0.31, 0.71, a.r * 0.55 + flowB * 0.45);
      vec3 albedo = ramp(t);
      albedo *= 0.90 + 0.20 * a.b;   // fine streaks along the currents

      // Glossy water: soft wrapped light, sky reflected at grazing angles,
      // and a soft sheen where the sun is.
      float wrapLight = clamp((dot(n, sun) + 0.25) / 1.25, 0.0, 1.0);
      float ndh = max(dot(n, halfway), 0.0);
      float fresnel = 0.02 + 0.98 * pow(1.0 - max(dot(n, view), 0.0), 5.0);
      vec3 color = albedo * (0.38 + 0.82 * wrapLight);
      color = mix(color, lin(vec3(0.80, 0.89, 1.0)), fresnel * 0.4);
      // One soft sun glint on the sunlit side.
      float glintArea = pow(max(dot(n, halfway), 0.0), 18.0);
      color += pow(ndh, 40.0) * 0.10 * glintArea;

      // Thin clouds drift a little faster than the planet turns.
      float diffuse = max(dot(n, sun), 0.0);
      float cloud = texture(detail, rotY(s, time * 0.006)).a * 0.12;
      color = mix(color, vec3(1.0) * (0.55 + 0.45 * diffuse), cloud);

      color = pow(color, vec3(1.0 / 2.2));
      // Atmosphere seen edge on: blue, warming to the logo's pink at the very rim.
      float rim = pow(1.0 - n.z, 3.0);
      color = mix(color, mix(vec3(0.64, 0.79, 1.0), vec3(0.96, 0.84, 0.92), smoothstep(0.55, 1.0, rim)), rim * 0.34);

      // A trace of noise keeps soft gradients free of banding.
      color += (fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453) - 0.5) / 255.0;
      outColor = vec4(color * coverage, coverage);
    }`;

  function program(context: WebGL2RenderingContext, fragment: string) {
    const make = (type: number, source: string) => {
      const shader = context.createShader(type)!;
      context.shaderSource(shader, source);
      context.compileShader(shader);
      if (!context.getShaderParameter(shader, context.COMPILE_STATUS)) throw new Error(context.getShaderInfoLog(shader) ?? 'shader');
      return shader;
    };
    const prog = context.createProgram()!;
    context.attachShader(prog, make(context.VERTEX_SHADER, QUAD));
    context.attachShader(prog, make(context.FRAGMENT_SHADER, fragment));
    context.bindAttribLocation(prog, 0, 'position');
    context.linkProgram(prog);
    if (!context.getProgramParameter(prog, context.LINK_STATUS)) throw new Error(context.getProgramInfoLog(prog) ?? 'link');
    return prog;
  }

  function start(context: WebGL2RenderingContext) {
    context.bindBuffer(context.ARRAY_BUFFER, context.createBuffer());
    context.bufferData(context.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), context.STATIC_DRAW);
    context.enableVertexAttribArray(0);
    context.vertexAttribPointer(0, 2, context.FLOAT, false, 0, 0);

    const bake = program(context, BAKE);
    const draw = program(context, DRAW);

    const detail = context.createTexture()!;
    context.bindTexture(context.TEXTURE_CUBE_MAP, detail);
    context.texStorage2D(context.TEXTURE_CUBE_MAP, Math.log2(FACE_SIZE) + 1, context.RGBA8, FACE_SIZE, FACE_SIZE);
    context.texParameteri(context.TEXTURE_CUBE_MAP, context.TEXTURE_MIN_FILTER, context.LINEAR_MIPMAP_LINEAR);
    context.texParameteri(context.TEXTURE_CUBE_MAP, context.TEXTURE_MAG_FILTER, context.LINEAR);
    const framebuffer = context.createFramebuffer();

    // Six bake steps, one cube face per frame.
    const steps = [0, 1, 2, 3, 4, 5];
    const bakeStep = () => {
      const face = steps.shift()!;
      context.useProgram(bake);
      context.bindFramebuffer(context.FRAMEBUFFER, framebuffer);
      context.framebufferTexture2D(context.FRAMEBUFFER, context.COLOR_ATTACHMENT0, context.TEXTURE_CUBE_MAP_POSITIVE_X + face, detail, 0);
      if (context.checkFramebufferStatus(context.FRAMEBUFFER) !== context.FRAMEBUFFER_COMPLETE) throw new Error('framebuffer');
      context.viewport(0, 0, FACE_SIZE, FACE_SIZE);
      context.uniform1i(context.getUniformLocation(bake, 'face'), face);
      context.uniform1f(context.getUniformLocation(bake, 'size'), FACE_SIZE);
      context.drawArrays(context.TRIANGLE_STRIP, 0, 4);
      context.bindFramebuffer(context.FRAMEBUFFER, null);
    };
    const finishBake = () => {
      context.bindTexture(context.TEXTURE_CUBE_MAP, detail);
      context.generateMipmap(context.TEXTURE_CUBE_MAP);
      context.useProgram(draw);
      context.activeTexture(context.TEXTURE0);
      context.bindTexture(context.TEXTURE_CUBE_MAP, detail);
      context.uniform1i(context.getUniformLocation(draw, 'detail'), 0);
    };

    const uOrient = context.getUniformLocation(draw, 'orient');
    const uTime = context.getUniformLocation(draw, 'time');
    const uPixel = context.getUniformLocation(draw, 'pixel');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const autoSpeed = () => (still.matches ? 0 : (Math.PI * 2) / SECONDS_PER_TURN);

    // Orientation as a rotation matrix (row-major) from view space to planet space.
    type M3 = number[];
    const mul = (a: M3, b: M3): M3 => {
      const r = new Array(9).fill(0);
      for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) for (let k = 0; k < 3; k++) r[i * 3 + j] += a[i * 3 + k] * b[k * 3 + j];
      return r;
    };
    const rotX = (a: number): M3 => [1, 0, 0, 0, Math.cos(a), -Math.sin(a), 0, Math.sin(a), Math.cos(a)];
    const rotY = (a: number): M3 => [Math.cos(a), 0, Math.sin(a), 0, 1, 0, -Math.sin(a), 0, Math.cos(a)];
    const transpose = (m: M3): M3 => [m[0], m[3], m[6], m[1], m[4], m[7], m[2], m[5], m[8]];
    // Keep the matrix a clean rotation after many small steps.
    const tidy = (m: M3): M3 => {
      let x = [m[0], m[3], m[6]];
      let y = [m[1], m[4], m[7]];
      const len = (v: number[]) => Math.hypot(v[0], v[1], v[2]);
      x = x.map((c) => c / len(x));
      const d = x[0] * y[0] + x[1] * y[1] + x[2] * y[2];
      y = y.map((c, i) => c - d * x[i]);
      y = y.map((c) => c / len(y));
      const z = [x[1] * y[2] - x[2] * y[1], x[2] * y[0] - x[0] * y[2], x[0] * y[1] - x[1] * y[0]];
      return [x[0], y[0], z[0], x[1], y[1], z[1], x[2], y[2], z[2]];
    };
    // Turn the planet as an object, in view space: positive yaw moves the surface
    // right, positive pitch moves it down, matching the drag.
    const turnObject = (m: M3, yaw: number, pitch: number) => mul(m, transpose(mul(rotY(yaw), rotX(pitch))));

    let orient = mul(rotY(0.8), [1, 0, 0, 0, Math.cos(TILT), -Math.sin(TILT), 0, Math.sin(TILT), Math.cos(TILT)]);
    let spin = autoSpeed(); // the planet's own turn, radians per second
    let yawRate = 0; // flick left over after a drag, radians per second
    let pitchRate = 0;
    let water = 0;
    let last = 0;
    let dragging = false;
    let running = false;
    let pointer = { x: 0, y: 0, t: 0 };

    const render = (now: number) => {
      if (steps.length) {
        bakeStep();
        if (!steps.length) {
          finishBake();
          root.classList.add('ready');
        }
        requestAnimationFrame(render);
        return;
      }
      const dt = last ? Math.min((now - last) / 1000, 0.05) : 0;
      last = now;
      if (!dragging) {
        // A flick glides and fades; the slow turn on the planet's own axis comes back.
        orient = turnObject(orient, yawRate * dt, pitchRate * dt);
        const fade = Math.exp(-dt * 1.8);
        yawRate *= fade;
        pitchRate *= fade;
        spin += (autoSpeed() - spin) * (1 - Math.exp(-dt * 1.2));
        orient = mul(rotY(spin * dt), orient);
      }
      orient = tidy(orient);
      if (!still.matches) water += dt;

      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const size = Math.round(canvas.clientWidth * ratio);
      if (canvas.width !== size) canvas.width = canvas.height = size;
      context.viewport(0, 0, size, size);
      context.uniform1f(uPixel, 2 / size);
      context.uniformMatrix3fv(uOrient, false, transpose(orient)); // GL wants column-major
      context.uniform1f(uTime, water);
      context.drawArrays(context.TRIANGLE_STRIP, 0, 4);

      const moving = dragging || !still.matches || Math.abs(yawRate) + Math.abs(pitchRate) > 0.002 || Math.abs(spin) > 0.002;
      if (moving) requestAnimationFrame(render);
      else running = false;
    };
    const wake = () => {
      if (running) return;
      running = true;
      last = 0;
      requestAnimationFrame(render);
    };

    // Drag to turn: the surface follows the pointer in every direction, all the way round.
    canvas.addEventListener('pointerdown', (e) => {
      if (steps.length) return;
      dragging = true;
      canvas.setPointerCapture(e.pointerId);
      pointer = { x: e.clientX, y: e.clientY, t: performance.now() };
      yawRate = pitchRate = 0;
      spin = 0;
      root.classList.add('dragging');
      wake();
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const now = performance.now();
      const dt = Math.max((now - pointer.t) / 1000, 1 / 240);
      const perPixel = (Math.PI * 1.4) / canvas.clientWidth;
      const yaw = (e.clientX - pointer.x) * perPixel;
      const pitch = (e.clientY - pointer.y) * perPixel;
      orient = turnObject(orient, yaw, pitch);
      yawRate = yawRate * 0.4 + (yaw / dt) * 0.6;
      pitchRate = pitchRate * 0.4 + (pitch / dt) * 0.6;
      pointer = { x: e.clientX, y: e.clientY, t: now };
    });
    const release = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      if (canvas.hasPointerCapture(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
      // Holding still before letting go means no flick.
      if (performance.now() - pointer.t > 80) yawRate = pitchRate = 0;
      yawRate = Math.max(-8, Math.min(8, yawRate));
      pitchRate = Math.max(-8, Math.min(8, pitchRate));
      root.classList.remove('dragging');
      wake();
    };
    canvas.addEventListener('pointerup', release);
    canvas.addEventListener('pointercancel', release);

    running = true;
    requestAnimationFrame(render);
    still.addEventListener('change', wake);
  }

  if (gl) {
    try {
      start(gl);
    } catch {
      // Keep the plain logo.
    }
  }
</script>

<style>
  .globe {
    position: relative;
    width: min(48vmin, 320px);
    aspect-ratio: 1;
    isolation: isolate;
    /* Lets what is placed inside size itself to the planet (cqw). */
    container-type: inline-size;
  }
  canvas,
  .fallback {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
  }
  canvas {
    opacity: 0;
    transition: opacity 0.9s var(--ease);
    cursor: grab;
    /* Dragging the planet turns it instead of scrolling the page. */
    touch-action: none;
  }
  .dragging canvas {
    cursor: grabbing;
  }
  .ready canvas {
    opacity: 1;
  }
  .ready .fallback {
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }
  .fallback {
    pointer-events: none;
    inset: 8%;
    width: 84%;
    height: 84%;
    border-radius: 50%;
  }
</style>
