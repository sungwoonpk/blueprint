---
// Header menu: Home, then the site's subjects. Built on the popover attribute, so
// clicking outside or pressing Escape closes it without extra code.
import { subjects } from '../data/subjects';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const items = [{ name: 'Home', path: '/' }, ...subjects];
---

<button type="button" class="icon-btn" id="menu-button" popovertarget="site-menu" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <path d="M4 7h16M4 12h16M4 17h16"></path>
  </svg>
</button>

<nav id="site-menu" popover aria-label="Site">
  <ul>
    {
      items.map((s) => (
        <li>
          <a href={s.path} aria-current={isCurrent(s.path) ? 'page' : undefined}>
            <span class="name">{s.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const button = document.getElementById('menu-button')!;
  const menu = document.getElementById('site-menu')!;

  // Close the menu before following a link, so the page transition does not
  // start with the menu still on screen.
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));

  // Place the menu under the button, right edges aligned.
  menu.addEventListener('beforetoggle', (e) => {
    const open = (e as ToggleEvent).newState === 'open';
    button.setAttribute('aria-expanded', String(open));
    if (!open) return;
    const r = button.getBoundingClientRect();
    menu.style.top = `${r.bottom + 8}px`;
    menu.style.right = `${Math.max(8, window.innerWidth - r.right)}px`;
  });
</script>

<style>
  #site-menu {
    position: fixed;
    inset: auto;
    margin: 0;
    min-width: 220px;
    padding: 6px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.14), 0 2px 6px rgb(0 0 0 / 0.06);
    opacity: 0;
    transform: translateY(-4px) scale(0.98);
    transform-origin: top right;
    /* Fade in on open only: closing is instant, because a menu still fading out
       sits in the top layer and makes the browser cancel page transitions. */
  }
  #site-menu:popover-open {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.16s var(--ease),
      transform 0.16s var(--ease);
  }
  @starting-style {
    #site-menu:popover-open {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px;
    border-radius: 9px;
    font-size: 15px;
    transition: background-color 0.15s var(--ease);
  }
  a:hover {
    background: var(--surface);
  }
  a[aria-current='page'] .name {
    font-weight: 600;
    color: var(--accent);
  }
</style>
