---
// The index is small (a few hundred titles), so it is embedded in the page and
// matched in the browser. No server, no build step.
import { searchEntries } from '../data/search';

const json = JSON.stringify(searchEntries).replace(/</g, '\\u003c');
---

<button type="button" class="icon-btn" data-search-open aria-label="Search topics" title="Search (⌘K)">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="M20 20l-3.5-3.5"></path>
  </svg>
</button>

<dialog id="search" aria-label="Search topics">
  <div class="field">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-3.5-3.5"></path>
    </svg>
    <input
      id="search-input"
      type="search"
      placeholder="Search topics"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="true"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <kbd>esc</kbd>
  </div>
  <ul id="search-results" role="listbox" aria-label="Results"></ul>
  <p id="search-empty" hidden></p>
</dialog>

<script type="application/json" id="search-data" set:html={json} />

<script>
  import type { SearchEntry } from '../data/search';
  import { normalize, toTerms, escapeHtml, highlight } from '../lib/match';

  const entries: SearchEntry[] = JSON.parse(document.getElementById('search-data')!.textContent!);
  const dialog = document.getElementById('search') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const list = document.getElementById('search-results') as HTMLUListElement;
  const empty = document.getElementById('search-empty') as HTMLParagraphElement;
  const MAX_RESULTS = 50;

  const index = entries.map((e) => normalize(e.title));

  let results: SearchEntry[] = [];
  let active = 0;

  /** 0: title starts with the query, 1: a word starts with it, 2: found anywhere. */
  function rank(text: string, query: string): number {
    if (text.startsWith(query)) return 0;
    if (text.includes(' ' + query)) return 1;
    return 2;
  }

  function search(raw: string) {
    const terms = toTerms(raw);
    const query = terms.join(' ');

    if (terms.length === 0) {
      // Before typing, offer the phases as quick jumps.
      results = entries.filter((e) => e.context === '');
    } else {
      results = entries
        .map((entry, i) => ({ entry, i, text: index[i] }))
        .filter(({ text }) => terms.every((t) => text.includes(t)))
        .sort((a, b) => rank(a.text, query) - rank(b.text, query) || a.i - b.i)
        .slice(0, MAX_RESULTS)
        .map(({ entry }) => entry);
    }

    active = 0;
    list.innerHTML = results
      .map(
        (r, i) => `<li role="option" id="search-option-${i}" aria-selected="${i === 0}">
          <a href="${r.href}" tabindex="-1">
            <span class="label num">${escapeHtml(r.label)}</span>
            <span class="title">${highlight(r.title, terms)}</span>
            ${r.context ? `<span class="context">${escapeHtml(r.context)}</span>` : ''}
          </a>
        </li>`,
      )
      .join('');

    empty.hidden = results.length > 0;
    empty.textContent = results.length ? '' : `No topics match “${raw.trim()}”.`;
    setActive(0);
  }

  function setActive(i: number) {
    const options = list.querySelectorAll<HTMLLIElement>('[role="option"]');
    if (options.length === 0) {
      input.removeAttribute('aria-activedescendant');
      return;
    }
    active = (i + options.length) % options.length;
    options.forEach((o, n) => o.setAttribute('aria-selected', String(n === active)));
    input.setAttribute('aria-activedescendant', options[active].id);
    options[active].scrollIntoView({ block: 'nearest' });
  }

  function open() {
    if (dialog.open) return;
    input.value = '';
    search('');
    dialog.showModal();
    input.focus();
  }

  // The header icon always opens the dialog. On the roadmap page the keyboard
  // shortcuts focus the inline filter instead, which shows the shortcut hint.
  const inline = document.getElementById('roadmap-search') as HTMLInputElement | null;
  function start() {
    if (!inline) return open();
    inline.scrollIntoView({ behavior: 'smooth', block: 'center' });
    inline.focus({ preventScroll: true });
    inline.select();
  }
  document.querySelectorAll('[data-search-open]').forEach((el) => el.addEventListener('click', open));

  document.addEventListener('keydown', (e) => {
    const typing = e.target instanceof HTMLElement && e.target.closest('input, textarea, [contenteditable]');
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? dialog.close() : start();
    } else if (e.key === '/' && !typing && !dialog.open) {
      e.preventDefault();
      start();
    }
  });

  input.addEventListener('input', () => search(input.value));

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(active + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(active - 1);
    } else if (e.key === 'Enter' && results[active]) {
      e.preventDefault();
      dialog.close();
      window.location.href = results[active].href;
    }
  });

  list.addEventListener('mousemove', (e) => {
    const option = (e.target as HTMLElement).closest<HTMLLIElement>('[role="option"]');
    if (!option) return;
    const i = [...list.children].indexOf(option);
    if (i !== active) setActive(i);
  });

  // Close when a result is followed (also needed for same-page "#phase" links)
  // or when the backdrop outside the panel is clicked.
  list.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    const r = dialog.getBoundingClientRect();
    const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
    if (!inside) dialog.close();
  });
</script>

<style is:global>
  html:has(#search[open]) {
    overflow: hidden;
  }

  #search {
    width: min(620px, calc(100% - 32px));
    max-height: min(560px, calc(100vh - 160px));
    margin: 12vh auto auto;
    padding: 0;
    overflow: hidden;
    display: none;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.18), 0 2px 8px rgb(0 0 0 / 0.06);
  }
  #search[open] {
    display: flex;
    animation: search-in 0.18s var(--ease);
  }
  #search::backdrop {
    background: rgb(0 0 0 / 0.25);
    backdrop-filter: blur(2px);
    animation: search-fade 0.18s var(--ease);
  }
  @keyframes search-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }
  @keyframes search-fade {
    from {
      opacity: 0;
    }
  }

  #search .field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 18px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }
  #search-input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 18px;
    letter-spacing: -0.015em;
  }
  #search-input::-webkit-search-cancel-button {
    display: none;
  }
  #search kbd {
    padding: 2px 6px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--muted);
  }

  #search-results {
    margin: 0;
    padding: 8px;
    overflow-y: auto;
    list-style: none;
  }
  #search-results:empty {
    display: none;
  }
  #search-results a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
  }
  #search-results [aria-selected='true'] a {
    background: var(--surface);
  }
  #search-results .label {
    flex: none;
    min-width: 4.2ch;
    font-size: 13px;
    color: var(--muted);
  }
  #search-results .title {
    flex: 1;
    min-width: 0;
  }
  #search-results mark {
    font-weight: 600;
  }
  #search-results .context {
    flex: none;
    max-width: 40%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    #search-results .context {
      display: none;
    }
  }
  #search-empty {
    padding: 28px 18px;
    text-align: center;
    color: var(--muted);
  }
</style>
