---
// One topic's page inside a subject. Until its article exists it says so.
import Base from '../layouts/Base.astro';
import type { NumberedTopic } from '../lib/roadmap';
import type { Subject } from '../data/subjects';

interface Props {
  subject: Subject;
  topic: NumberedTopic;
  prev?: NumberedTopic;
  next?: NumberedTopic;
}

const { subject, topic, prev, next } = Astro.props;
---

<Base title={`${topic.number} ${topic.title}`} width="narrow">
  <a class="back" href={`${subject.path}#${topic.phase.slug}`}>
    <svg viewBox="0 0 8 14" width="8" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 1L1 7l6 6" />
    </svg>
    {topic.phase.title}
  </a>

  <article>
    <p class="number num">{topic.number}</p>
    <h1>{topic.title}</h1>
    <p class="soon">Coming soon.</p>
  </article>

  <nav class="pager" aria-label="Previous and next topic">
    {
      prev ? (
        <a href={`${subject.path}/${prev.slug}`}>
          <span class="label">Previous</span>
          <span class="title">{prev.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a href={`${subject.path}/${next.slug}`} class="next">
          <span class="label">Next</span>
          <span class="title">{next.title}</span>
        </a>
      )
    }
  </nav>
</Base>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    color: var(--accent);
  }
  .back svg {
    transition: transform 0.2s var(--ease);
  }
  .back:hover svg {
    transform: translateX(-2px);
  }

  article {
    margin-top: 56px;
  }
  .number {
    font-size: 15px;
    color: var(--muted);
  }
  h1 {
    margin-top: 4px;
    font-size: clamp(34px, 6vw, 48px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .soon {
    margin-top: 32px;
    color: var(--muted);
  }

  .pager {
    display: grid;
    gap: 16px;
    margin-top: 96px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  @media (min-width: 600px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pager .next {
    text-align: right;
    grid-column: 2;
  }
  .label {
    font-size: 13px;
    color: var(--muted);
  }
  .title {
    transition: color 0.2s var(--ease);
  }
  .pager a:hover .title {
    color: var(--accent);
  }
</style>
